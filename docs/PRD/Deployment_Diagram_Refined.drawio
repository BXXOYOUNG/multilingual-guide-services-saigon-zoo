          <mxGeometry x="40" y="904" width="442" height="24" as="geometry" />
        </mxCell>
        <mxCell id="133" value="5. Dịch: API giữ preview → Chrome dịch → admin duyệt → API" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#536D78;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="930" width="456" height="24" as="geometry" />
        </mxCell>
        <mxCell id="134" value="   commit transaction MongoDB. Mô hình thuộc Chrome profile." style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#536D78;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="956" width="456" height="24" as="geometry" />
        </mxCell>
        <mxCell id="135" value="NGOẠI TUYẾN &amp; PHẠM VI TRIỂN KHAI" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=18;fontStyle=1;fontColor=#203B45;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1030" width="335" height="26" as="geometry" />
        </mxCell>
        <mxCell id="136" value="Dùng POI / gói / audio đã tải và shell đã cache trên cùng origin." style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#536D78;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1064" width="456" height="24" as="geometry" />
        </mxCell>
        <mxCell id="137" value="Đổi URL tunnel tạo origin khác; OSM vẫn cần mạng." style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#536D78;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1090" width="379" height="24" as="geometry" />
        </mxCell>
        <mxCell id="138" value="GPS / camera cần quyền browser và localhost hoặc HTTPS." style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#536D78;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1116" width="437" height="24" as="geometry" />
        </mxCell>
        <mxCell id="139" value="Native translation tùy Chrome desktop / cặp ngôn ngữ;" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#536D78;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1142" width="395" height="24" as="geometry" />
        </mxCell>
        <mxCell id="140" value="không hỗ trợ thì nhập tay. Tải model lần đầu cần Internet." style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#536D78;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1168" width="417" height="24" as="geometry" />
        </mxCell>
        <mxCell id="141" value="Backup DB / media tách khỏi Git; mỗi máy chạy bản riêng." style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#536D78;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1194" width="421" height="24" as="geometry" />
        </mxCell>
        <mxCell id="142" value="Script chuẩn bị có thể gọi Edge TTS trực tiếp như backend." style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#536D78;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1220" width="429" height="24" as="geometry" />
        </mxCell>
        <mxCell id="143" value="Ký hiệu UML &amp; ranh giới" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=18;fontStyle=1;fontColor=#203B45;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1360" width="214" height="26" as="geometry" />
        </mxCell>
        <mxCell id="144" value="«device»: máy vật lý · «execution environment» / «container» / «browser»: môi trường thực thi · «artifact»: bản build / mã triển khai." style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#536D78;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1394" width="945" height="24" as="geometry" />
        </mxCell>
        <mxCell id="145" value="Đường liền: kết nối runtime / lưu trữ; nét đứt: vận hành. Frontend và FastAPI ở host; dữ liệu không công khai qua tunnel. Không có worker TTS bền vững." style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#536D78;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1420" width="1105" height="24" as="geometry" />
        </mxCell>
      </root>
