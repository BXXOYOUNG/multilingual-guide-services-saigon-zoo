# Copy values into the backend process environment before starting FastAPI.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Existing local MongoDB replica set; use this database only for development.
MONGODB_URI=mongodb://127.0.0.1:27018/?replicaSet=rs0
MONGODB_DATABASE=saigon_zoo_tcv_dataset_dev

# Local Redis container used for admin session storage.
REDIS_URL=redis://127.0.0.1:6379/0

# Audio API uses the S3-compatible provider only when all four values are set.
# Configure these after verifying the SeaweedFS S3 endpoint, bucket and keys.
AUDIO_STORAGE_ENDPOINT_URL=
AUDIO_STORAGE_BUCKET=
AUDIO_STORAGE_ACCESS_KEY_ID=
AUDIO_STORAGE_SECRET_ACCESS_KEY=
AUDIO_STORAGE_REGION=us-east-1
AUDIO_STORAGE_PRESIGNED_URL_EXPIRES_IN=300

# Optional demo TTS provider. Requires network access and creates unreviewed audio.
TTS_PROVIDER=edge-tts
ADMIN_COOKIE_SECURE=false

